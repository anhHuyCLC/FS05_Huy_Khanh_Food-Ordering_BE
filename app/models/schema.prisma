// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
  // url       = env("DATABASE_URL")
}

model User {
  id        String    @id() @default(uuid()) @map("id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  deleted   Boolean   @default(false) @map("deleted")

  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  middleName  String?  @map("middle_name")
  email       String   @unique @map("email")
  status      String   @default("PENDING") @map("status") // ACTIVE, INACTIVE, PENDING
  avatarUrl   String?  @map("avatar_url")
  gender      String?  @map("gender")
  phoneNumber String?  @map("phone_number")
  address     String?  @map("address")
  profile     Profile?

  googleId String? @unique @map("google_id")

  // Relations
  roles             UserToRole[]
  permissions       UserToPermission[]
  passwords         Password[]
  roleCreated       Role[]             @relation("createdBy")
  roleUpdated       Role[]             @relation("updatedBy")
  featureCreated    Feature[]          @relation("createdBy")
  featureUpdated    Feature[]          @relation("updatedBy")
  permissionCreated Permission[]       @relation("createdBy")
  permissionUpdated Permission[]       @relation("updatedBy")
  requestCreator    Request[]          @relation("createdBy")
  requestApprover   Request[]          @relation("approvedBy")

  @@map("users")
}

model Password {
  id        String    @id() @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  deleted   Boolean   @default(false) @map("deleted")

  password String
  userId   String @map("user_id") @db.Uuid
  type     String @default("PASSWORD") @map("type") // PASSWORD, OTP, REFRESH_TOKEN

  // Relation
  user User @relation(fields: [userId], references: [id])

  @@map("passwords")
}

model Role {
  id          String    @id() @default(uuid()) @map("id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  deleted Boolean @default(false) @map("deleted")

  code        String  @unique @map("code")
  name        String  @map("name")
  description String? @map("description")
  isReadOnly  Boolean @default(false) @map("is_read_only")

  // Relations
  users       UserToRole[]
  permissions RoleToPermission[]
  createdBy   User?              @relation("createdBy", fields: [createdById], references: [id])
  updatedBy   User?              @relation("updatedBy", fields: [updatedById], references: [id])

  @@map("roles")
}

model UserToRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_to_role")
}

model Feature {
  id          String    @id() @default(uuid()) @map("id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deleted     Boolean   @default(false) @map("deleted")

  code        String  @map("code")
  name        String  @map("name")
  description String? @map("description")
  type        String  @default("FEATURE") @map("type") // MENU_GROUP (cha, không có permission), SYSTEM, CORE, FEATURE
  parentId    String? @map("parent_id") @db.Uuid
  sortOrder   Int     @default(0) @map("sort_order")

  // Relations
  parent      Feature?     @relation("featureRelation", fields: [parentId], references: [id])
  childs      Feature[]    @relation("featureRelation")
  permissions Permission[]
  createdBy   User?        @relation("createdBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("updatedBy", fields: [updatedById], references: [id])

  @@map("features")
}

model Permission {
  id          String    @id() @default(uuid()) @map("id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deleted     Boolean   @default(false) @map("deleted")

  code        String  @map("code")
  name        String  @map("name")
  description String? @map("description")
  type        String  @default("FEATURE") @map("type") // SYSTEM, CORE, FEATURE
  featureId   String  @map("feature_id") @db.Uuid

  // Relations
  feature   Feature            @relation(fields: [featureId], references: [id])
  users     UserToPermission[]
  roles     RoleToPermission[]
  createdBy User?              @relation("createdBy", fields: [createdById], references: [id])
  updatedBy User?              @relation("updatedBy", fields: [updatedById], references: [id])

  @@map("permissions")
}

model UserToPermission {
  userId       String    @map("user_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at")

  // Relations
  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
  @@map("user_to_permission")
}

model RoleToPermission {
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_to_permission")
}

model Request {
  id          String    @id() @default(uuid()) @map("id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  requestType    String    @map("request_type") // CREATE_TASK
  jsonParameters String    @map("json_parameters")
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById   String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at")

  // Relation
  requester User  @relation("createdBy", fields: [createdById], references: [id])
  approver  User? @relation("approvedBy", fields: [approvedById], references: [id])

  @@map("requests")
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  delivering
  completed
  cancelled
}

enum OrderType {
  standard_delivery
  dine_in
  group_order
  blind_box
}

model Profile {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @unique @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String @map("full_name") @db.VarChar(255)

  phone     String?  @unique @db.VarChar(20)
  avatarUrl String?  @map("avatar_url") @db.Text
  isActive  Boolean? @default(true) @map("is_active")

  // Gamification
  rewardPoints Int?    @default(0) @map("reward_points")
  badgeLevel   String? @default("Newbie") @map("badge_level") @db.VarChar(50)

  // Push Notification [NEW]
  deviceTokens String[] @default([]) @map("device_tokens") // Lưu danh sách FCM tokens để gửi Push App

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  restaurants              Restaurant[]
  driverProfile            DriverProfile?
  orders                   Order[]                   @relation("CustomerOrders")
  socialPosts              SocialPost[]
  postInteractions         PostInteraction[]
  restaurantReviews        RestaurantReview[]        @relation("RestaurantReviewer")
  driverReviews            DriverReview[]            @relation("DriverReviewer")
  menuItemReviews          MenuItemReview[]          @relation("MenuItemReviewer")
  carts                    Cart[]
  chatbotSessions          ChatbotSession[]
  cartItems                CartItem[]                @relation("CartItemAddedBy")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")
  notifications            Notification[]
  followers        UserFollow[]   @relation("UserFollowings") 
  followings       UserFollow[]   @relation("UserFollowers")  
  postReports      PostReport[]   @relation("UserReports")   
  achievedBadges   UserBadge[]                                
  missionProgresses UserMission[]                              
  pointHistories   PointHistory[]
  savedAddresses   SavedAddress[]

  @@map("profiles")
}

model Restaurant {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  address     String   @db.Text
  imageUrl    String?  @map("image_url") @db.Text
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  isActive    Boolean? @default(false) @map("is_active")
  rating      Decimal? @default(0.0) @db.Decimal(3, 2) // Denormalized for performance
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  // [BỔ SUNG MỚI] Phục vụ tính năng Duyệt đối tác & Quản lý chiết khấu hệ thống
  approvalStatus  String   @default("PENDING") @map("approval_status") // PENDING, APPROVED, REJECTED
  rejectionReason String?  @map("rejection_reason")
  commissionRate  Decimal  @default(10.0) @map("commission_rate") @db.Decimal(5, 2) // % chiết khấu quán trả hệ thống
  cuisineType     String?  @map("cuisine_type") @db.VarChar(100)
  openTime        String?  @map("open_time") @db.VarChar(10)
  closeTime       String?  @map("close_time") @db.VarChar(10)

  owner       Profile           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  categories  Category[]
  menuItems   MenuItem[]
  orders      Order[]            @relation("RestaurantOrders")
  socialPosts SocialPost[]
  promotions  Promotion[]
  carts       Cart[]
  reviews     RestaurantReview[]

  @@index([ownerId])
  @@map("restaurants")
}

model DriverProfile {
  id            String   @id @default(uuid()) @db.Uuid
  vehicleInfo   String?  @map("vehicle_info") @db.VarChar(255)
  licensePlate  String?  @map("license_plate") @db.VarChar(50)
  currentStatus String?  @default("offline") @map("current_status") @db.VarChar(50)
  walletBalance Decimal? @default(0.0) @map("wallet_balance") @db.Decimal(15, 2)
  rating        Decimal? @default(0.0) @db.Decimal(3, 2)
  // [BỔ SUNG MỚI] Phục vụ tính năng Duyệt tài xế & Hoa hồng giao hàng
  approvalStatus  String   @default("PENDING") @map("approval_status") // PENDING, APPROVED, REJECTED
  rejectionReason String?  @map("rejection_reason")
  commissionRate  Decimal  @default(15.0) @map("commission_rate") @db.Decimal(5, 2) // Tỷ lệ hoa hồng đơn hàng của tài xế
  driverLicenseNumber String? @map("driver_license_number") @db.VarChar(50)
  nationalIdNumber     String? @map("national_id_number") @db.VarChar(50)


  profile      Profile             @relation(fields: [id], references: [id], onDelete: Cascade)
  orders       Order[]             @relation("DriverOrders")
  transactions WalletTransaction[]
  reviews      DriverReview[]
  locations    DriverLocation[]

  @@map("driver_profiles")
}

model Category {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  name         String @db.VarChar(100)
  sortOrder    Int?   @default(0) @map("sort_order")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("categories")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  categoryId   String?  @map("category_id") @db.Uuid
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  basePrice    Decimal  @map("base_price") @db.Decimal(15, 2)
  imageUrl     String?  @map("image_url") @db.Text
  isAvailable  Boolean? @default(true) @map("is_available")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems   OrderItem[]
  cartItems    CartItem[]
  optionGroups OptionGroup[]
  reviews      MenuItemReview[]

  appliedPromotions Promotion[] @relation("PromotionToMenuItems") // [NEW] Hỗ trợ Flash Sale cho món cụ thể

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

// Chuẩn hóa 3NF cho Menu Options (Toppings, Sizes, etc.)
model OptionGroup {
  id         String  @id @default(uuid()) @db.Uuid
  menuItemId String  @map("menu_item_id") @db.Uuid
  name       String  @db.VarChar(100) // e.g., "Chọn Size", "Thêm Topping"
  isRequired Boolean @default(false) @map("is_required")
  maxChoices Int?    @map("max_choices") // null means unlimited

  menuItem MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  choices  OptionChoice[]

  @@unique([menuItemId, name])
  @@index([menuItemId])
  @@map("option_groups")
}

model OptionChoice {
  id              String  @id @default(uuid()) @db.Uuid
  optionGroupId   String  @map("option_group_id") @db.Uuid
  name            String  @db.VarChar(100) // e.g., "Size L", "Trân châu"
  additionalPrice Decimal @default(0.0) @map("additional_price") @db.Decimal(15, 2)

  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@unique([optionGroupId, name])
  @@index([optionGroupId])
  @@map("option_choices")
}

// Khuyến mãi / Mã giảm giá
model Promotion {
  id                 String   @id @default(uuid()) @db.Uuid
  restaurantId       String?  @map("restaurant_id") @db.Uuid // Null if it's a global platform code
  code               String   @unique @db.VarChar(50)
  description        String?  @db.Text
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  fixedDiscount      Decimal? @map("fixed_discount") @db.Decimal(15, 2)
  minOrderValue      Decimal? @default(0.0) @map("min_order_value") @db.Decimal(15, 2)
  validFrom          DateTime @map("valid_from") @db.Timestamptz()
  validTo            DateTime @map("valid_to") @db.Timestamptz()
  isActive           Boolean? @default(true) @map("is_active")
  promotionType      String   @default("food") @map("promotion_type") @db.VarChar(50)

  restaurant      Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders          Order[]
  applicableItems MenuItem[]  @relation("PromotionToMenuItems") // [NEW] Hỗ trợ Flash Sale cho món cụ thể

  @@index([restaurantId])
  @@map("promotions")
}

// Giỏ hàng & Shareable Cart (Group Order)
model Cart {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  isGroupCart  Boolean  @default(false) @map("is_group_cart")
  sessionToken String?  @unique @map("session_token") @db.VarChar(255) // URL token for sharing
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  // [BỔ SUNG MỚI] Lưu ID của những thành viên tham gia Giỏ hàng nhóm (Group Order) trước khi checkout
  invitedUserIds String[] @default([]) @map("invited_user_ids")

  owner      Profile    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      CartItem[] @relation("CartToItems")

  @@index([ownerId])
  @@index([restaurantId])
  @@map("carts")
}

model CartItem {
  id              String  @id @default(uuid()) @db.Uuid
  cartId          String  @map("cart_id") @db.Uuid
  menuItemId      String  @map("menu_item_id") @db.Uuid
  addedByUserId   String? @map("added_by_user_id") @db.Uuid // Biết ai thêm món trong Group Order
  quantity        Int
  selectedOptions Json?   @default("{}") @map("selected_options") // JSON is better here for cart flexibility
  note            String? @db.Text

  cart        Cart     @relation("CartToItems", fields: [cartId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  addedByUser Profile? @relation("CartItemAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([menuItemId])
  @@map("cart_items")
}

model Order {
  id           String  @id @default(uuid()) @db.Uuid
  customerId   String? @map("customer_id") @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  driverId     String? @map("driver_id") @db.Uuid
  promotionId  String? @map("promotion_id") @db.Uuid

  orderType OrderType @default(standard_delivery) @map("order_type")

  // Dine-in Pre-order [NEW]
  tableNumber     String?   @map("table_number") @db.VarChar(50)
  reservationTime DateTime? @map("reservation_time") @db.Timestamptz()

  status OrderStatus @default(pending)

  // Financial specifics
  totalAmount    Decimal  @map("total_amount") @db.Decimal(15, 2)
  discountAmount Decimal? @default(0.0) @map("discount_amount") @db.Decimal(15, 2)
  finalAmount    Decimal  @map("final_amount") @db.Decimal(15, 2)

  // Platform Fee / Revenue Tracking [NEW]
  platformFee   Decimal @default(0.0) @map("platform_fee") @db.Decimal(15, 2) // Tiền hệ thống thu
  restaurantNet Decimal @default(0.0) @map("restaurant_net") @db.Decimal(15, 2) // Tiền quán thực nhận

  paymentStatus PaymentStatus @default(pending) @map("payment_status")
  isPaid        Boolean?       @default(false) @map("is_paid")

  deliveryAddress   String?  @map("delivery_address") @db.Text
  deliveryLatitude  Decimal? @map("delivery_latitude") @db.Decimal(10, 8)
  deliveryLongitude Decimal? @map("delivery_longitude") @db.Decimal(11, 8)
  customerPhone     String?  @map("customer_phone") @db.VarChar(20)
  note              String?  @db.Text

  groupParticipants Json? @default("[]") @map("group_participants") // { userId, amountContributed }

  // [BỔ SUNG MỚI] Hỗ trợ Tự động gán tài xế tuần tự
  assignmentQueue     Json?     @default("[]") @map("assignment_queue")
  currentDriverId     String?   @map("current_driver_id") @db.Uuid
  assignmentExpiresAt DateTime? @map("assignment_expires_at")

  // Fraud Detection (Gian lận) [NEW]
  deviceIp  String?  @map("device_ip") @db.VarChar(50)
  deviceId  String?  @map("device_id") @db.VarChar(255)
  isFlagged Boolean  @default(false) @map("is_flagged")
  riskScore Decimal? @map("risk_score") @db.Decimal(5, 2)

  // Timestamps
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz()
  preparingAt  DateTime? @map("preparing_at") @db.Timestamptz()
  deliveringAt DateTime? @map("delivering_at") @db.Timestamptz()
  completedAt  DateTime? @map("completed_at") @db.Timestamptz()
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz()
  // [BỔ SUNG MỚI] Thứ tự điểm dừng giao hàng khi tài xế sử dụng tính năng Gom đơn (Route Optimization)
  deliverySequence Int?      @map("delivery_sequence")

  // Relations
  customer             Profile?             @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  restaurant           Restaurant           @relation("RestaurantOrders", fields: [restaurantId], references: [id], onDelete: Restrict)
  driver               DriverProfile?       @relation("DriverOrders", fields: [driverId], references: [id], onDelete: SetNull)
  promotion            Promotion?           @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  orderItems           OrderItem[]
  payment              Payment[]
  restaurantReviews    RestaurantReview[]
  orderStatusHistories OrderStatusHistory[]

  @@index([customerId])
  @@index([restaurantId])
  @@index([driverId])
  @@index([promotionId])
  @@index([status])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([restaurantId, status])
  @@index([deliverySequence], map: "orders_delivery_sequence_idx")
  @@index([status, driverId], map: "orders_status_driver_id_idx")
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  menuItemId      String  @map("menu_item_id") @db.Uuid
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(15, 2) // Lịch sử giá
  selectedOptions Json?   @default("{}") @map("selected_options") // Lịch sử topping (Snapshot)
  note            String? @db.Text

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// Giao dịch ví tài xế
model WalletTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  driverId        String   @map("driver_id") @db.Uuid
  amount          Decimal  @db.Decimal(15, 2)
  transactionType String   @map("transaction_type") @db.VarChar(50) // 'deposit', 'withdrawal', 'earning', 'platform_fee'
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// Chatbot AI
model ChatbotSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  messages  Json     @default("[]") // Lưu lịch sử chat dưới dạng mảng JSON [{"role": "user", "content": "..."}, {"role": "model", "content": "..."}]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chatbot_sessions")
}

model SocialPost {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  restaurantId  String?  @map("restaurant_id") @db.Uuid
  content       String   @db.Text
  mediaUrls     Json?    @default("[]") @map("media_urls")
  taggedItems   Json?    @default("[]") @map("tagged_items")
  likesCount    Int?     @default(0) @map("likes_count") // Denormalized counter
  commentsCount Int?     @default(0) @map("comments_count") // Denormalized counter
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user         Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  interactions PostInteraction[]
  // [BỔ SUNG MỚI] Quan hệ đối ứng kết nối với bảng báo cáo vi phạm bài viết
  reports      PostReport[]

  @@index([userId])
  @@index([restaurantId])
  @@index([createdAt])
  @@map("social_posts")
}

model PostInteraction {
  id              String   @id @default(uuid()) @db.Uuid
  postId          String   @map("post_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  interactionType String   @map("interaction_type") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, interactionType])
  @@map("post_interactions")
}

model RestaurantReview {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String? @map("order_id") @db.Uuid
  reviewerId   String  @map("reviewer_id") @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid

  rating         Int
  comment        String? @db.Text
  replyFromOwner String? @map("reply_from_owner") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  order      Order?     @relation(fields: [orderId], references: [id])
  reviewer   Profile    @relation("RestaurantReviewer", fields: [reviewerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([orderId, reviewerId, restaurantId])
  @@index([restaurantId])
  @@index([reviewerId])
  @@index([orderId])
  @@map("restaurant_reviews")
}

model DriverReview {
  id         String @id @default(uuid()) @db.Uuid
  reviewerId String @db.Uuid
  driverId   String @db.Uuid

  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reviewer Profile       @relation("DriverReviewer", fields: [reviewerId], references: [id])
  driver   DriverProfile @relation(fields: [driverId], references: [id])

  @@unique([reviewerId, driverId])
  @@index([driverId])
  @@index([reviewerId])
  @@map("driver_reviews")
}

model MenuItemReview {
  id         String @id @default(uuid()) @db.Uuid
  reviewerId String @db.Uuid
  menuItemId String @db.Uuid

  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reviewer Profile  @relation("MenuItemReviewer", fields: [reviewerId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([reviewerId, menuItemId])
  @@index([menuItemId])
  @@index([reviewerId])
  @@map("menu_item_reviews")
}

enum PaymentProvider {
  momo
  vnpay
}

enum PaymentMethod {
  cash
  e_wallet
  bank_transfer
}

enum PaymentStatus {
  pending
  success
  failed
  cancelled
  refunded
}

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  method   PaymentMethod    @map("payment_method")
  provider PaymentProvider? @map("provider")
  status   PaymentStatus    @default(pending)

  amount   Decimal @db.Decimal(15, 2)
  currency String  @default("VND")

  transactionId   String?   @unique @map("transaction_id")
  paymentUrl      String?   @map("payment_url") @db.Text
  responseData    Json?     @map("response_data")
  paymentCode     String?   @unique @map("payment_code")
  providerOrderId String?   @unique @map("provider_order_id")
  paidAt          DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([provider])
  @@index([status])
  @@map("payments")
}

model Notification {
  id         String @id @default(uuid()) @db.Uuid
  receiverId String @db.Uuid

  title   String
  content String?
  type    String // ORDER, PAYMENT, CHAT

  isRead Boolean @default(false)

  metadata  Json?
  createdAt DateTime @default(now())

  receiver Profile @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId])
}

model OrderStatusHistory {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  status OrderStatus

  note      String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model DriverLocation {
  driverId String @id @unique @db.Uuid

  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)

  updatedAt DateTime @updatedAt

  driver DriverProfile @relation(fields: [driverId], references: [id])

  @@map("driver_locations")
}

model Conversation {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  createdAt DateTime @default(now())

  isGroup   Boolean @default(false) @map("is_group")
  name      String? @db.VarChar(255)
  avatarUrl String? @map("avatar_url")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @map("conversation_id") @db.Uuid
  profileId      String @map("profile_id") @db.Uuid

  joinedAt DateTime @default(now()) @map("joined_at")

  isAdmin    Boolean   @default(false) @map("is_admin")
  lastReadAt DateTime? @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([conversationId, profileId])
  @@index([conversationId])
  @@index([profileId])
  @@map("conversation_participants")
}

model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @map("conversation_id") @db.Uuid
  senderId       String @map("sender_id") @db.Uuid

  content String @db.Text

  type String @default("TEXT") // TEXT, IMAGE, VIDEO, FILE

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender Profile @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// Tính năng: Khách hàng Follow người dùng khác / Reviewer tích cực
model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  Profile @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following Profile @relation("UserFollowings", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("user_follows")
}

// Tính năng: Admin quản lý báo cáo (Report) bài viết vi phạm trên Social Feed
model PostReport {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  reporterId  String   @map("reporter_id") @db.Uuid
  reason      String   @db.Text
  status      String   @default("PENDING") // PENDING (Chờ duyệt), RESOLVED (Đã xử lý xóa bài), DISMISSED (Hợp lệ)
  createdAt   DateTime @default(now()) @map("created_at")

  post     SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter Profile    @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("post_reports")
}

// Quản lý các cấu hình Huy hiệu hệ thống (ví dụ: Thánh Ăn Đêm, Chiến Thần Review)
model Badge {
  id             String      @id @default(uuid()) @db.Uuid
  name           String      @unique @db.VarChar(100)
  description    String?     @db.Text
  imageUrl       String?     @map("image_url") @db.Text
  pointsRequired Int         @map("points_required") // Số điểm tích lũy tối thiểu để mở khóa
  
  userBadges     UserBadge[]

  @@map("badges")
}
// Bảng lưu thông tin Huy hiệu thực tế mà người dùng đã đạt được
model UserBadge {
  profileId String   @map("profile_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at")

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([profileId, badgeId])
  @@map("user_badges")
}
// Hệ thống quản lý nhiệm vụ tích điểm (Nhiệm vụ ngày, Nhiệm vụ tuần, Sự kiện)
model Mission {
  id           String        @id @default(uuid()) @db.Uuid
  title        String        @db.VarChar(255)
  description  String?       @db.Text
  pointsReward Int           @map("points_reward") // Điểm nhận được khi hoàn thành
  type         String        @default("DAILY")     // DAILY, WEEKLY, SPECIAL
  targetCount  Int           @default(1) @map("target_count") // Số mục tiêu (ví dụ: Đặt 3 đơn thì targetCount = 3)
  isActive     Boolean       @default(true) @map("is_active")

  userMissions UserMission[]

  @@map("missions")
}

// Theo dõi tiến độ làm nhiệm vụ của từng Khách hàng
model UserMission {
  profileId   String    @map("profile_id") @db.Uuid
  missionId   String    @map("mission_id") @db.Uuid
  currentProgress Int   @default(0) @map("current_progress") // Tiến độ hiện tại (ví dụ: Đã đặt 2 đơn -> ghi nhận số 2)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@id([profileId, missionId])
  @@map("user_missions")
}

// Nhật ký biến động điểm (Tích điểm từ đơn hàng, cộng điểm hoàn thành nhiệm vụ, trừ điểm đổi voucher)
model PointHistory {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  amount    Int      // Số điểm biến động (Số dương như +50 nếu tích điểm, số âm như -100 nếu đổi voucher)
  reason    String   // Loại nghiệp vụ: "ORDER_REWARD", "MISSION_COMPLETED", "REDEEM_VOUCHER"
  createdAt DateTime @default(now()) @map("created_at")

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("point_histories")
}

model SavedAddress {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label     String   @db.VarChar(100)
  address   String   @db.Text
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  phone     String?  @db.VarChar(20)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("saved_addresses")
}
